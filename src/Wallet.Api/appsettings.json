{
  "RateLimiting": {
    "Enabled": true,
    "Policies": {
      "anonymous-strict": { "Capacity": 30, "WindowSeconds": 60 },
      "anonymous-register": { "Capacity": 50, "WindowSeconds": 3600 },
      "authenticated": { "Capacity": 100, "WindowSeconds": 60 },
      "authenticated-write": { "Capacity": 20, "WindowSeconds": 60 }
    }
  },
  "Forwarding": {
    "Enabled": false,
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
