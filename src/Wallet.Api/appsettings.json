{
  "RateLimiting": {
    "Enabled": true,
    "Policies": {
      "anonymous-strict": { "Capacity": 5, "RefillPerMinute": 5 },
      "authenticated": { "Capacity": 100, "RefillPerMinute": 100 },
      "authenticated-write": { "Capacity": 20, "RefillPerMinute": 20 }
    }
  },
  "Forwarding": {
    "Enabled": false,
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
